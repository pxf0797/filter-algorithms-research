# === Logging ===
LOGURU_LEVEL=INFO

# === Streamlit ===
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# === Database ===
DB_PATH=data/market.db
CONFIG_DB_PATH=data/config.db

# === Backtest ===
BACKTEST_MAX_BARS=100000
BACKTEST_PARALLEL_VIEWS=1

# === yfinance ===
YFINANCE_TIMEOUT=30

# === Optional: Sentry ===
# SENTRY_DSN=

# === Optional: Slack webhook for alerts ===
# SLACK_WEBHOOK_URL=

# === Environment (development | production) ===
ENV=development

# === Pipeline Capture (set to 1 to enable per-step backtest data collection) ===
# PIPELINE_CAPTURE=1
